<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI-Classic.xsd">

    <Frame name="GACTestTalentTreeFrame" toplevel="true" parent="UIParent" enableMouse="true" hidden="true" inherits="ButtonFrameTemplate">
        <Size x="384" y="512"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        
        <Frames>
            <Button name="$parentTab1" inherits="CharacterFrameTabButtonTemplate" id="1" text="Tab 1">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT">
                        <Offset x="15" y="2"/>
                    </Anchor>
                </Anchors>
            </Button>
            <Button name="$parentTab2" inherits="CharacterFrameTabButtonTemplate" id="2" text="Tab 2">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentTab1" relativePoint="RIGHT">
                        <Offset x="-15" y="0"/>
                    </Anchor>
                </Anchors>
            </Button>
            <Button name="$parentTab3" inherits="CharacterFrameTabButtonTemplate" id="3" text="Tab 3">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentTab2" relativePoint="RIGHT">
                        <Offset x="-15" y="0"/>
                    </Anchor>
                </Anchors>
            </Button>
            
            <!-- Use ScrollFrame instead of Frame to properly create ScrollChild -->
            <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentInset" x="4" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentInset" x="-26" y="4"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <!-- Parchment Overlay for content area, inside ScrollFrame to cover Inset background -->
                        <Texture name="$parentParchment" file="Interface\AchievementFrame\UI-Achievement-Parchment">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-4" y="4"/>
                                <Anchor point="BOTTOMRIGHT" x="26" y="-4"/>
                            </Anchors>
                            <TexCoords left="0" right="0.65" top="0" bottom="0.9"/>
                        </Texture>
                    </Layer>
                </Layers>
                <ScrollChild>
                    <Frame name="$parentScrollChild">
                        <Size x="330" y="500"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
        
        <Scripts>
            <OnLoad>
                tinsert(UISpecialFrames, self:GetName())
                SetPortraitToTexture(self.portrait, "Interface\\Icons\\Spell_Nature_NatureTouchGrow")
                self.TitleText:SetText("Talent Tree Test")
            </OnLoad>
        </Scripts>
    </Frame>

    <Script file="index.lua"/>
</Ui>
